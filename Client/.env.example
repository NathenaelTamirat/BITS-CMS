# Frontend env. Copy to .env (or .env.local) and edit as needed.

# Override the API base URL. Leave empty for dev (Vite proxy at /api → :3000).
# In production, set to the absolute origin of the backend if it's served
# on a different host:
#   VITE_API_URL=https://api.bitscollege.edu.et
VITE_API_URL=
