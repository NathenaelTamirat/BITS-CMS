{
  "name": "cms",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node -e \"const fs=require('fs'),pg=require('pg');const sql=fs.readFileSync('migrations.sql','utf8');const c=new pg.Client({host:process.env.DB_HOST,port:process.env.DB_PORT,user:process.env.DB_USER,password:process.env.DB_PASSWORD,database:process.env.DB_NAME});c.connect().then(()=>c.query(sql)).then(()=>{console.log('Migration complete.');return c.end()}).catch(e=>{console.error(e);process.exit(1)})\"",
    "seed:admin": "tsx src/DB/adminseed.ts",
    "deploy": "npm run migrate && echo 'Run seed:admin separately with SEED_SUPERADMIN_EMAIL and SEED_SUPERADMIN_PASSWORD env vars'",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/**/*.test.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dompurify": "^3.4.12",
    "dotenv": "^16.0.0",
    "express": "^5.2.1",
    "jsdom": "^29.1.1",
    "multer": "^2.1.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
