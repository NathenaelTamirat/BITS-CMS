# ─── Database ────────────────────────────────────────────────────────────────
# Postgres connection (must match the postgres service in docker-compose.yml)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme_use_strong_password
DB_NAME=school_cms

# ─── JWT Secrets ─────────────────────────────────────────────────────────────
# CRITICAL: Both must be set and MUST be different values.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=changeme_generate_random_value
JWT_REFRESH_SECRET=changeme_generate_random_value

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Must include the homepage's public
# origin and the Studio domain. Never use "*" in production.
# CORS_ORIGIN=https://www.bitscollege.edu.et,https://studio.bitscollege.edu.et,http://localhost:5173
CORS_ORIGIN=https://www.bitscollege.edu.et,https://studio.bitscollege.edu.et,http://localhost:5173

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Cookie ──────────────────────────────────────────────────────────────────
REFRESH_COOKIE_NAME=refreshToken

# ─── Superadmin Seed (one-time only — do NOT persist after first run) ────────
# Supply these as one-off env vars when running `npm run seed:admin`, not here.
# SEED_SUPERADMIN_EMAIL=you@bitscollege.edu.et
# SEED_SUPERADMIN_PASSWORD=<strong-unique-password>
